<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mingli.luopan" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>时空罗盘</name>
    <description>二十四山指南针 · 干支黄历 · 玄空飞星 · 八宅游年 · 同步码</description>
    <author>mingli</author>
    <content src="index.html" />
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <uses-permission name="android.permission.INTERNET" />
    <uses-permission name="android.permission.ACCESS_FINE_LOCATION" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-buildToolsVersion" value="34.0.0" />
        <icon src="res/icon.png" />
    </platform>
</widget>
